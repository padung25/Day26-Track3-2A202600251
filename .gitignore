# Python bytecode/cache
__pycache__/
*.py[cod]
*$py.class

# Test/cache artifacts
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Local virtual environments
.venv/
venv/
env/

# Runtime SQLite databases generated by init_db.py
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal

# Local environment and logs
.env
.env.*
*.log

# Node/npm cache artifacts that may be created by MCP Inspector
node_modules/
.npm-cache/
npm-debug.log*

# OS/editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
